[sub_resource type="GDScript" id="GDScript_gametype"]
script/source = "extends Control

## Practice menu: highlights the option in machine var practice_game_type
## (0 Normal Game, 1 Video Mode Practice, 2 Final Battle Practice).
## MPF (attract.yaml) owns the selection; this only draws it.

const NAMES := [\"NORMAL GAME\", \"VIDEO MODE PRACTICE\", \"FINAL BATTLE PRACTICE\"]
const ON_COLOR := Color(1.0, 0.74, 0.2, 1)
const OFF_COLOR := Color(0.5, 0.56, 0.58, 1)

var _sel: int = 0

func _ready() -> void:
	_sel = int(MPF.game.machine_vars.get(\"practice_game_type\", 0))
	MPF.game.connect(\"machine_update\", _on_machine_update)
	_refresh()

func _exit_tree() -> void:
	if MPF.game.is_connected(\"machine_update\", _on_machine_update):
		MPF.game.disconnect(\"machine_update\", _on_machine_update)

func _on_machine_update(var_name: String, value: Variant) -> void:
	if var_name == \"practice_game_type\":
		_sel = int(value)
		_refresh()

func _refresh() -> void:
	for i in range(3):
		var lbl := get_node_or_null(\"Option%d\" % i) as Label
		if lbl == null:
			continue
		if i == _sel:
			lbl.text = \"> \" + NAMES[i] + \" <\"
			lbl.add_theme_color_override(\"font_color\", ON_COLOR)
		else:
			lbl.text = NAMES[i]
			lbl.add_theme_color_override(\"font_color\", OFF_COLOR)
"

